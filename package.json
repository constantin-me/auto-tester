{
  "name": "auto-tester",
  "version": "0.1.0",
  "description": "AI-driven visual E2E testing system: watches code changes, guesses affected UI flows, drives a browser, reports behavioral differences (advisory).",
  "type": "module",
  "scripts": {
    "bootstrap": "tsx src/cli/bootstrap.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "jev:smoke": "tsx --env-file-if-exists=.env src/cli/jev-smoke.ts",
    "eval:prepare": "tsx src/cli/eval-prepare.ts",
    "eval": "tsx --env-file-if-exists=.env src/cli/eval.ts",
    "qa:baseline": "tsx --env-file-if-exists=.env src/cli/qa-baseline.ts"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "puppeteer": "^25.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
